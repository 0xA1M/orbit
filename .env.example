# copy to .env and fill in real values. .env is gitignored, this file is safe to commit.
AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>
TF_STATE_BUCKET=your-globally-unique-state-bucket
TF_VAR_DOMAIN_NAME=your-hostname.example.com
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-dns-edit
TF_VAR_cloudflare_zone_id=your-cloudflare-zone-id
