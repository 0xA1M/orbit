{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.3/.schema/devbox.schema.json",
  "packages": [
    "opentofu@latest",
    "go@latest",
    "gopls@latest",
    "grpcurl@latest",
    "terraform-ls@latest"
  ],
  "env": {
    "AWS_REGION": "us-east-1"
  },
  "shell": {
    "init_hook": [
      "echo 'orbit env ready.'",
      "echo '  infra-ecs: devbox run infra-ecs-<init|plan|apply|destroy|validate>'",
      "echo '  bootstrap: devbox run bootstrap-<init|plan|apply|destroy|validate>'",
      "echo '  ci-iam:    devbox run ci-iam-<init|plan|apply|destroy|validate>'",
      "echo '  helpers:   devbox run <fmt|sts|ecr-login>'"
    ],
    "scripts": {
      "fmt": "tofu fmt -recursive .",
      "sts": "aws sts get-caller-identity",
      "ecr-login": "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin $(aws sts get-caller-identity --query Account --output text).dkr.ecr.us-east-1.amazonaws.com",
      "bootstrap-validate": "tofu -chdir=bootstrap validate",
      "bootstrap-init": "tofu -chdir=bootstrap init",
      "bootstrap-plan": "tofu -chdir=bootstrap plan",
      "bootstrap-apply": "tofu -chdir=bootstrap apply",
      "bootstrap-destroy": "tofu -chdir=bootstrap destroy",
      "infra-ecs-validate": "tofu -chdir=infra-ecs validate",
      "infra-ecs-init": "tofu -chdir=infra-ecs init -backend-config=backend.tfvars",
      "infra-ecs-plan": "tofu -chdir=infra-ecs plan",
      "infra-ecs-apply": "tofu -chdir=infra-ecs apply",
      "infra-ecs-destroy": "tofu -chdir=infra-ecs destroy",
      "ci-iam-validate": "tofu -chdir=ci-iam validate",
      "ci-iam-init": "tofu -chdir=ci-iam init -backend-config=backend.tfvars",
      "ci-iam-plan": "tofu -chdir=ci-iam plan",
      "ci-iam-apply": "tofu -chdir=ci-iam apply",
      "ci-iam-destroy": "tofu -chdir=ci-iam destroy"
    }
  },
  "aliases": {
    "tf": "tofu"
  }
}
